# Port the server listens on
PORT=3000

# MongoDB connection string (replace with your own local or Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/maintainIQ

# Secret used to sign login tokens. Generate a strong random value locally and
# never commit the real value.
JWT_SECRET=replace-with-a-strong-random-secret

# How long login tokens stay valid (optional, defaults to 1d when set)
JWT_EXPIRES_IN=1d

# development or production. Must be "production" in real deployments: it turns
# on the Secure flag on auth cookies and enables the required-config checks.
NODE_ENV=development

# Public frontend base URL. Used as the CORS origin (only this origin may call
# the API with credentials) and inside generated QR codes. Required in
# production; for the live frontend set:
#   FRONTEND_URL=https://maintain-iq-frontend-one.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: separate database name used by the test suite. Tests connect to the
# same cluster/URI but this database, so real data is never touched. Defaults to
# "maintainiq_test" when unset.
MONGO_TEST_DB=maintainiq_test

# Auth rate limiting (login per IP). Optional; defaults to a 15 minute window
# with a maximum of 20 failed attempts (successful logins are not counted).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Register rate limiting (per IP). Optional; defaults to a 1 hour window with a
# maximum of 10 attempts.
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10

# Public asset-lookup rate limiting (per IP). Optional; defaults to a 1 minute
# window with a maximum of 120 requests.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# Image-upload signature endpoint rate limiting (per IP). Optional; defaults to
# a 1 minute window with a maximum of 30 requests.
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=30

# ImageKit (optional). When all three values are set, admins can attach images
# to assets: the backend signs short-lived parameters and the browser uploads
# directly to ImageKit. Leave blank to disable image uploads (assets still work
# without images). Never commit real keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional: upload folder inside your ImageKit media library.
IMAGEKIT_UPLOAD_FOLDER=/maintainiq/assets
